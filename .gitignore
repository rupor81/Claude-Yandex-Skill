# BMAD skill trees rendered by the installer — regenerate with:
#   npx bmad-method install --directory . --modules bmm --tools claude-code --yes
.agents/
.claude/skills/

# Machine-local Claude Code settings
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
# `.venv` is a symlink to `.venv.nosync` here -- see README, "The environment".
# No trailing slash: `.venv/` matches only a directory, and a symlink is not one.
.venv
.venv.nosync/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store

# BMAD personal install answers (name, language) — installer-managed, per-developer
_bmad/config.user.toml

# Packed Claude extensions -- rebuilt from extensions/ with `mcpb pack`.
dist/
